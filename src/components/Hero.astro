---
// Tanect Hero — Based on Mindful Figma template, adapted for Tanect brand.
//
// 2026-07-28：奈良の四季を流す画像スライド（hero-nara*.png 5枚）を LP から外した。
//  - LP の仕事は「インストールしてもらう」こと。風景のスライドショーはそこに寄与せず、
//    1024px 未満で1カラムに折り返すと画像が縦に大きく場所を取り、**CTA を画面外へ押し下げていた**
//  - 併せて左寄せをやめて中央揃えに統一。左寄せは2カラム（左=コピー／右=画像）前提の配置で、
//    画像が無くなると他セクション（すべて text-align:center）と不揃いになるため
//  - 画像ファイルは public/images/ に残してある。奈良の風景はコーポレート側（HP）で使う
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const INSTALL_URL = `${base}/home/install`;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <span class="badge">🌱 家族のあゆみを、やさしくつなぐ</span>

      <h1 class="hero-title">
        <span class="hero-title-line">日々のあゆみを、</span>
        <span class="hero-title-line hero-title-emphasis">家族とそっとつなぐ。</span>
      </h1>

      <p class="hero-lead">
        Tanect Home は、離れて暮らすご家族と、日々のあゆみをそっと共有するアプリです。<br />
        言葉にしない気配まで、やさしくつなぐ。見守りではなく「つながり」を、管理ではなく「共感」を。
      </p>

      <p class="hero-monitor-note">
        いまは、より良いアプリへ育てるための<strong>家族モニター</strong>を募集しています。離れて暮らすご家族を思うあなたの率直なご意見が、開発のいちばんの力になります。
      </p>

      <div class="hero-actions">
        <a href={INSTALL_URL} class="btn btn-accent" data-track-event="monitor_install_click" data-cta-location="hero">
          <span class="hero-cta-emoji" aria-hidden="true">📱</span>
          アプリを入れて試す
        </a>
        <a href="#monitor" class="btn btn-secondary">どんな協力をするの？</a>
      </div>

      <div class="hero-proof">
        <div class="avatars" aria-hidden="true">
          <span class="avatar avatar-1"></span>
          <span class="avatar avatar-2"></span>
          <span class="avatar avatar-3"></span>
        </div>
        <p class="proof-text">離れていても、家族はそばに</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-3xl) 0;
    overflow: hidden;
  }

  .hero-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  /* 他セクション（ThreeGenerationScenarios / Features）と同じく中央揃えに統一する */
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    text-align: center;
  }

  .hero-title {
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-tight);
    letter-spacing: 0.012em;
    color: var(--color-text);
  }

  .hero-title-line {
    display: block;
  }

  .hero-title-emphasis {
    color: var(--color-primary);
  }

  /* 本文は「中央に置いた箱の中で左揃え」。見出し・CTA は中央のまま。
     2〜3行ある本文を中央揃えにすると行頭が揃わず読みにくいため（2026-07-28）。 */
  .hero-lead {
    max-width: 560px;
    text-align: left;
    font-size: var(--fs-body);
    line-height: 1.8;
    color: var(--color-text-muted);
    letter-spacing: -0.025em;
  }

  /* メルマガ流入者（子世代・テスト協力者）を受け止める一言 */
  .hero-monitor-note {
    max-width: 560px;
    text-align: left;
    font-size: var(--fs-small);
    line-height: 1.8;
    color: var(--color-text);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
  }

  .hero-monitor-note strong {
    color: var(--color-accent-ink);
    font-weight: 700;
  }

  .hero-cta-emoji {
    font-size: 1.1em;
    line-height: 1;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
  }

  /* Social proof row */
  .hero-proof {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    padding-top: var(--space-md);
  }

  .avatars {
    display: inline-flex;
  }

  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    box-shadow: 0 0 0 1px var(--color-border-subtle);
  }

  .avatar + .avatar {
    margin-left: -7px;
  }

  .avatar-1 {
    background: var(--color-avatar-1);
  }
  .avatar-2 {
    background: var(--color-avatar-2);
  }
  .avatar-3 {
    background: var(--color-avatar-3);
  }

  .proof-text {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    letter-spacing: -0.002em;
  }

  /* Tablet and up */
  @media (min-width: 768px) {
    .hero {
      padding: calc(var(--space-3xl) * 1.2) 0;
    }

    .hero-title {
      font-size: 42px;
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .hero-title {
      font-size: var(--fs-h1-lg);
    }
  }
</style>
