---
// よくある質問 — <details> ベースのアコーディオン
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type Qa = {
  q: string;
  a: string;
  link?: { href: string; label: string };
};

const faqs: Qa[] = [
  {
    q: 'どんな人が参加できますか？',
    a: '離れて暮らすご家族とのつながりを大切にしたい方なら、どなたでもご参加いただけます。スマホの操作が苦手なご家族がいても大丈夫。やさしい操作モードや音声入力で、毎日のひと言を自然に残せます。',
  },
  {
    q: 'スマホの操作が苦手な家族でも使えますか？',
    a: 'はい。大きな文字とボタンの「やさしい操作モード」や、話すだけで記録できる音声入力を用意しています。予定の登録は離れた家族が代わりに行うこともできます。',
  },
  {
    q: '家族とメッセージのやりとり（チャット）はできますか？',
    a: 'チャット機能は、あえて入れていません。会話は「返さなきゃ」という気持ちを生み、返せない日が続くと自然と止まってしまうからです。Tanect Home にあるのは、日々のひと言と、それに「いいね・応援」を送るしくみだけ。返事はいりません。「見てるよ」だけが届きます。そのうえで、伝えたくなった記録は LINE やメールで送ることもできます。込み入ったお話は電話で。その手前にある、言葉にならない毎日の気配を、Tanect Home が受け持ちます。',
  },
  // 共有できるのは「記録1件」のみ（2026-07-30 時点）。AI週次レポートの共有は未実装なので書かない。
  // 実装は OS 標準の共有シートに画像を渡す方式（アプリ内の「活動の保存・共有」ボタン）。
  // 画像 ＝ 受け取る側にアプリが要らない、が訴求の中心。リンクではないので期限やログインも無い。
  {
    q: '記録を、LINEやメールで送ることはできますか？',
    a: 'はい。記録の「活動の保存・共有」から、その1件を画像として書き出せます。LINE・メール・メッセージなど、お使いのアプリでそのまま送れますし、写真として手元に残しておくこともできます。画像でお送りするので、受け取る方に Tanect Home は必要ありません。アプリを使っていないご家族や親戚にも、「これ見て」とそのまま渡せます。',
  },
  // 通知の種類はアプリの実装と対応させること（増減したらこの回答も直す）。
  // 「通知は来ません」とは書かない ＝ 実際に届くので嘘になる。
  // 言うべきは「応じなかったことが誰にも残らない」（QuietByDesign.astro 冒頭のコメント参照）。
  {
    q: '通知はたくさん来ますか？',
    a: '来る通知は4種類だけです。ご自身で登録した予定のアラーム、記録が続いた日を祝うバッジ、ご家族からいいねが届いたときのお知らせ、そしてご家族の新しい記録のお知らせ。このうち何かをお願いするのは最後のひとつだけで、それも「よければ👍をひとつ」というお誘いです。押さなくても、ご家族には分かりません。「まだ書いていません」と急かす通知もありません。書かない日も、暮らしのうちですから。',
  },
  {
    q: 'ペットの様子も記録できますか？',
    a: 'はい。家族設定でペットを登録すると、ホーム画面の「ペットの様子」から写真を撮って記録できます。撮った写真とそのときの状況をもとに、AIがペットの様子をやさしい言葉で綴ります。健康を断定するものではなく、あくまで想像のおしゃべりとしてお楽しみください。',
  },
  {
    q: '対応している端末は？',
    a: 'スマートフォン（iPhone / Android）でご利用いただけます。家族モニター参加のご案内時に、インストール方法を個別にお送りします。',
  },
  {
    q: 'いつまでお試しできますか？',
    a: '家族モニターとしてお試しいただける期間は、2026年8月31日（月）までです。この間に、毎日の記録と「AI週次レポート」まで、ぜひ一度は体験してみてください。',
  },
  {
    q: '家族がいなくても、ひとりで試せますか？',
    a: 'はい、お一人でも試せます。ご自身の家族グループを作って記録を始めれば、記録がひとつでもあれば日曜の朝に「AI週次レポート」が届きます。ご家族は、あとからいつでも招待していただけます。',
  },
  {
    q: 'AI週次レポートはいつ届きますか？',
    a: '毎週日曜日の朝9時に、前の一週間の記録をまとめた「AI週次レポート」が作成されます。どこかで1週間ほど続けて記録いただくと、日曜の朝に受け取れます。ぜひ期間中に一度は体験してみてください。',
  },
  {
    q: '家族モニターが終わったら、これまでの記録はどうなりますか？',
    a: 'お試し期間のあとも続けてお使いいただけるよう、9月上旬の正式版公開を目指して準備を進めています。これまでの記録の取り扱いや続け方については、公開のときに改めてご案内しますので、どうぞ安心してお試しください。',
  },
  {
    q: '家族の情報はどう扱われますか？',
    a: '記録した内容は、招待した家族の中だけで共有されます。大切な毎日の記録だからこそ、取り扱いには十分配慮して運用しています。詳しくは参加時のご案内でお伝えします。',
    link: { href: `${base}/privacy`, label: '詳しくはプライバシーポリシーをご覧ください' },
  },
];
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="faq-inner">
    <header class="faq-head">
      <span class="badge">❓ よくある質問</span>
      <h2 class="faq-title" id="faq-title">
        気になることに、<wbr />お答えします。
      </h2>
    </header>

    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
            {item.link && (
              <p>
                <a
                  class="faq-link"
                  href={item.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >{item.link.label}</a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: var(--space-3xl) 0;
  }

  .faq-inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .faq-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .faq-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: var(--lh-tight);
    color: var(--color-text);
    letter-spacing: 0.012em;
    /* 文節の途中で折らず、<wbr> を入れた位置でのみ改行する */
    word-break: keep-all;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .faq-item {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq-item[open] {
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    letter-spacing: 0.005em;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background: var(--color-accent-ink);
    border-radius: 1px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  /* horizontal bar */
  .faq-icon::before {
    top: 50%;
    left: 0;
    width: 16px;
    height: 2px;
    transform: translateY(-50%);
  }

  /* vertical bar */
  .faq-icon::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 16px;
    transform: translateX(-50%);
  }

  .faq-item[open] .faq-icon::after {
    transform: translateX(-50%) scaleY(0);
  }

  .faq-answer {
    padding: 0 var(--space-lg) var(--space-lg);
    font-size: 14px;
    line-height: 1.85;
    color: var(--color-text-muted);
  }

  .faq-answer p + p {
    margin-top: var(--space-sm);
  }

  .faq-link {
    color: var(--color-accent-ink);
    text-decoration: underline;
  }

  /* Tablet and up */
  @media (min-width: 768px) {
    .faq-title {
      font-size: 36px;
    }

    .faq-question {
      font-size: 17px;
    }
  }
</style>
