---
// 家族モニター向け インストール案内ページ（/install）
//
// 公開LPのナビからはリンクしない「身内向け」ページ。
// 第一波モニターには、申し込み後の返信メール／LINE でこのページのURLを送る。
// /home/ 配下は検索に載せない（config.ts の INDEXABLE_PATHS に未掲載＝BaseLayout が自動で noindex,nofollow）。
//
// ⚠️ 差し替え必須：下の2つのリンクを、発行済みの実URLに書き換えてください。
//   - ANDROID_INVITE_LINK … Firebase App Distribution の monitors グループ「招待リンク」
//   - IOS_TESTFLIGHT_LINK  … App Store Connect → TestFlight 外部テストの「公開リンク」（Beta Review 承認後）
// （手順の出典：tanect-management/04_customers/monitor_onboarding.md §1・§3）
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SUPPORT_EMAIL } from '../../config';

// Step1: テスターとしての追加登録（招待リンク）
const ANDROID_INVITE_LINK = 'https://appdistribution.firebase.dev/i/e839ccc26eed5ed4';
// Step2: App Tester アプリのインストール（配布アプリのページ）
const ANDROID_APP_TESTER_LINK = 'https://appdistribution.firebase.google.com/testerapps/1:327542930366:android:7b5bde13423dc28fcd57ef/releases/07cu2l78drfag?utm_source=firebase-console';
// iOS の公開リンクは「枠（テスター上限）」の管理であって、来訪者に選ばせるものではない。
// 画面には常に1つだけ出し、枠が埋まったら下の IOS_TESTFLIGHT_LINK を差し替える運用にする
// （2026-07-27：公開リンクのテスター上限を 50→500 に引き上げたため、当面は1本で足りる）。
const IOS_TESTFLIGHT_LINK = 'https://testflight.apple.com/join/1hjBMcpE';
// 予備枠（旧・コネクティル様向けに分けていたリンク）。上の枠が埋まったらこちらへ差し替える。
// ※ 取引先名を公開ページに出さないため、ボタンのラベルには使わない。
const IOS_TESTFLIGHT_LINK_SPARE = 'https://testflight.apple.com/join/8aYDSyHK';

// リンクが未発行のうちは true にしておくと、ボタンを「準備中」表示にできる
const ANDROID_READY = true;
const IOS_READY = true;

const HOME_URL = import.meta.env.BASE_URL.replace(/\/$/, '') + '/home/';
const RELEASE_NOTES_URL = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/home/release-notes`;
const FAMILY_SETUP_URL = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/home/family-setup`;

const androidSteps = [
  'このページを <strong>Androidスマホ</strong> で開き、まず下の <strong>「① 登録ページを開く」</strong> ボタンを押します。',
  '<strong>Googleアカウント</strong>でサインインし、利用規約に同意します（テスター登録）。',
  '次に <strong>「② Androidでアプリを入れる」</strong> ボタンを押し、画面の案内に従って <strong>「App Tester」アプリ</strong> をインストールします。',
  'App Tester の中から <strong>Tanect Home</strong> をインストールします。<br />※「提供元不明のアプリ」の確認が出たら、画面の案内に従って許可してください（アプリストア以外からのお届けのためです）。',
  '次の新しいバージョンが出ると、App Tester からお知らせが届きます。',
];

// iPhone の手順（スクショ付き）
// ⚠️ スクショ配置：public/screens/ に下の4枚を置いてください（未配置の間はプレースホルダー表示）
const iosSteps = [
  {
    text: 'このページを <strong>iPhone</strong> で開き、下の <strong>「iPhoneでアプリを入れる」</strong> ボタンを押します。TestFlight の案内ページが開きます。',
    shot: 'ios-install-1-testflight-page.png',
    alt: 'TestFlightの案内ページ。「TestFlightを入手する」と「App Storeで表示する」ボタンが表示されている',
  },
  {
    text: '<strong>「App Storeで表示する」</strong>を押し、App Store で <strong>TestFlight アプリ</strong> を入れます。<br /><span class="step-sub">※ すでに TestFlight が入っている方は、この手順はとばして大丈夫です。</span>',
    shot: 'ios-install-2-appstore.png',
    alt: 'App StoreのTestFlightのページ。入手中の表示',
  },
  {
    text: 'TestFlight を開くと「ようこそTestFlightへ」の画面が出ます。いちばん下の <strong>「続ける」</strong> を押します。',
    shot: 'ios-install-3-welcome.png',
    alt: 'TestFlightのようこそ画面。下部に「続ける」ボタン',
  },
  {
    text: '<strong>TanectHome</strong> の横の <strong>「インストール」</strong> を押します。これでおしまいです！<br /><span class="step-sub">※ TanectHome が見当たらないときは、もう一度このページに戻って下のボタンを押してください。</span>',
    shot: 'ios-install-4-tanecthome.png',
    alt: 'TestFlightのアプリ一覧。TanectHomeの横にインストールボタン',
  },
];
---

<BaseLayout
  title="インストール方法 — Tanect Home（家族モニター）"
  description="Tanect Home 家族モニターのみなさん向けの、iPhone・Android それぞれのインストール手順のご案内です。"
>
  <header class="page-head">
    <a href={HOME_URL} class="logo" aria-label="Tanect Home トップへ">
      <img
        class="logo-mark"
        src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/app-icon.png`}
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="logo-text">Tanect<span class="logo-home"> Home</span></span>
    </a>
  </header>

  <main class="install">
    <div class="install-inner">
      <section class="intro">
        <span class="badge">🌱 家族モニターのみなさんへ</span>
        <h1 class="intro-title">インストール方法のご案内</h1>
        <p class="intro-lead">
          Tanect Home を試してくださり、ありがとうございます。<br />
          お使いのスマホにあわせて、下の手順どおりに進めてください。<br />
          むずかしい設定はありません。途中でつまずいても大丈夫です。
        </p>
        {/* 「思ったより長い」で離脱しないよう、所要時間とやることを先に開示する */}
        <div class="intro-time">
          <p class="intro-time-title">⏱ かかる時間の目安</p>
          <ul class="intro-time-list">
            <li>
              <span class="intro-time-device">iPhone</span>
              <span class="intro-time-body"><strong>約3分</strong>／Apple公式のテスト用アプリ「TestFlight」を入れてから、Tanect Home を入れます</span>
            </li>
            <li>
              <span class="intro-time-device">Android</span>
              <span class="intro-time-body"><strong>約5分</strong>／Googleアカウントでテスター登録をしてから、Tanect Home を入れます</span>
            </li>
          </ul>
          <p class="intro-time-note">このあとアプリでアカウントを作ります（メールに届く6けたの数字を入力します）。</p>
        </div>

        <p class="intro-pick">
          お使いの端末は <strong>iPhone</strong> ですか？ <strong>Android</strong> ですか？<br />
          <span class="intro-pick-note">下のボタンを押すと、その手順まで進みます。わからないときは、メールでお問い合わせください。</span>
        </p>
        {/* 端末を選ぶ手段。モバイルは1カラム縦積みで iPhone カード（スクショ4枚）が先に来るため、
            Android の人は長くスクロールしないと自分の手順に届かなかった。ここが最大の離脱点。
            あわせて下の script で、Android 端末なら Android カードを先頭へ並べ替える。 */}
        <div class="intro-jump">
          <a
            href="#iphone"
            class="btn btn-accent"
            data-track-event="install_device_pick"
            data-cta-location="ios"
          >🍎 iPhone の手順へ</a>
          <a
            href="#android"
            class="btn btn-accent"
            data-track-event="install_device_pick"
            data-cta-location="android"
          >🤖 Android の手順へ</a>
        </div>
      </section>

      <div class="cards" id="cards">
        <!-- iPhone -->
        <section class="card" id="iphone" aria-labelledby="iphone-title">
          <div class="card-head">
            <span class="card-emoji" aria-hidden="true">🍎</span>
            <h2 class="card-title" id="iphone-title">iPhone をお使いの方</h2>
          </div>
          <ol class="steps steps-shots">
            {iosSteps.map((s, i) => (
              <li class="step step-shot">
                <div class="shot">
                  <span class="shot-num" aria-hidden="true">{i + 1}</span>
                  <div class="shot-frame">
                    <img
                      src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/screens/${s.shot}`}
                      alt={s.alt}
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.hidden=false;"
                    />
                    <div class="shot-ph" aria-hidden="true" hidden>
                      <span>📱 スクリーンショット差し替え予定</span>
                      <code>screens/{s.shot}</code>
                    </div>
                  </div>
                </div>
                <p class="step-text step-text-shot" set:html={s.text} />
              </li>
            ))}
          </ol>
          <div class="card-cta">
            {IOS_READY ? (
              <a
                href={IOS_TESTFLIGHT_LINK}
                class="btn btn-accent"
                target="_blank"
                rel="noopener noreferrer"
                data-track-event="install_store_click"
                data-cta-location="ios_testflight"
              >
                iPhoneでアプリを入れる
              </a>
            ) : (
              <span class="btn btn-disabled" aria-disabled="true">準備中（リンクは個別にお送りします）</span>
            )}
            <p class="card-note">※ 次の新しいバージョンが出ると、TestFlight からお知らせが届きます。<br />※ うまくいかないときは、メールでお問い合わせください。</p>
            <a
              href={`mailto:${SUPPORT_EMAIL}`}
              class="btn btn-primary"
              data-track-event="install_support_mail_click"
              data-cta-location="ios_card"
            >メールを送る（{SUPPORT_EMAIL}）</a>
          </div>
        </section>

        <!-- Android -->
        <section class="card" id="android" aria-labelledby="android-title">
          <div class="card-head">
            <span class="card-emoji" aria-hidden="true">🤖</span>
            <h2 class="card-title" id="android-title">Android をお使いの方</h2>
          </div>
          <ol class="steps">
            {androidSteps.map((s, i) => (
              <li class="step">
                <span class="step-num" aria-hidden="true">{i + 1}</span>
                <span class="step-text" set:html={s} />
              </li>
            ))}
          </ol>
          <div class="card-cta">
            {ANDROID_READY ? (
              <div class="btn-steps">
                <a
                  href={ANDROID_INVITE_LINK}
                  class="btn btn-accent"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-event="install_store_click"
                  data-cta-location="android_register"
                >
                  ① 登録ページを開く
                </a>
                <a
                  href={ANDROID_APP_TESTER_LINK}
                  class="btn btn-accent"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-event="install_store_click"
                  data-cta-location="android_apptester"
                >
                  ② Androidでアプリを入れる
                </a>
              </div>
            ) : (
              <span class="btn btn-disabled" aria-disabled="true">準備中（リンクは個別にお送りします）</span>
            )}
            <p class="card-note">※ かならず <strong>①→②</strong> の順に進めてください。<br />※ うまくいかないときは、メールでお問い合わせください。</p>
            <a
              href={`mailto:${SUPPORT_EMAIL}`}
              class="btn btn-primary"
              data-track-event="install_support_mail_click"
              data-cta-location="android_card"
            >メールを送る（{SUPPORT_EMAIL}）</a>
          </div>
        </section>
      </div>

      <section class="notice" aria-labelledby="notice-title">
        <div class="notice-head">
          <span class="notice-emoji" aria-hidden="true">✉️</span>
          <h2 class="notice-title" id="notice-title">アプリを開いてアカウントを作るとき</h2>
        </div>
        <p class="notice-text">
          インストールが終わってアプリを開くと、はじめにアカウントを作ります。<br />
          そのとき、確認のための <strong>6けたの数字（コード）</strong> がメールで届きます。<br />
          このコードを入力すると、登録が完了します。
        </p>
        <p class="notice-text">
          メールの件名は <strong>「【Tanect Home】確認コード：（数字）」</strong> です。<br />
          差出人は自動送信用の英数字のアドレスになっています。<br />
          <strong>迷惑メール・プロモーションのフォルダ</strong>に入ってしまうことがあるので、受信トレイに見当たらないときは、そちらものぞいてみてください。
        </p>
        <p class="notice-note">※ コードは、届いてから <strong>10分のあいだ</strong> ご利用いただけます。見つからないときや時間が過ぎたときは、登録の画面からもう一度お送りできます。</p>
        <p class="notice-note">※ それでも届かないときは、メールでお問い合わせください。</p>
      </section>

      <section class="help">
        <h2 class="help-title">困ったときは</h2>
        <p class="help-text">
          途中で止まってしまっても、まったく問題ありません。<br />
          画面の写真を撮って、メールでお送りいただければ、こちらで一緒に確認します。<br />
          インストール後は、アプリ内の画面右上の人アイコン →「お問い合わせ」からもご連絡いただけます。
        </p>
        <p class="help-mail">
          <a
            href={`mailto:${SUPPORT_EMAIL}`}
            class="btn btn-primary"
            data-track-event="install_support_mail_click"
            data-cta-location="help_section"
          >メールを送る（{SUPPORT_EMAIL}）</a>
        </p>
        <div class="help-links">
          <a href={FAMILY_SETUP_URL} class="help-back">👪 アプリを開いたら（家族のつくり方）を見る</a>
          <a href={RELEASE_NOTES_URL} class="help-back">📓 最新の更新内容（リリースノート）を見る</a>
          <a href={HOME_URL} class="help-back">← Tanect Home のトップへもどる</a>
        </div>
      </section>
    </div>
  </main>

  <footer class="page-foot">
    <p class="page-foot-copy">© 2026 Tanect</p>
  </footer>

  {/* Android 端末で開いたときは Android カードを先頭にする（モバイルの1カラム時のみ効く）。
      JS が動かない環境では既定の並び（iPhone が先）のままで、内容は何も失われない。 */}
  <script>
    if (/Android/i.test(navigator.userAgent)) {
      document.getElementById('cards')?.classList.add('android-first');
    }
  </script>
</BaseLayout>

<style>
  /* ── ヘッダー（最小：ロゴのみ） ── */
  .page-head {
    border-bottom: 1px solid var(--color-border-subtle);
    background: rgba(255, 255, 255, 0.9);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-md);
    font-weight: 700;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: block;
  }

  .logo-text {
    font-size: 20px;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  /* ── 本文 ── */
  .install {
    padding: var(--space-3xl) var(--space-md);
    background: linear-gradient(180deg, var(--color-accent-soft) 0%, #ffffff 320px);
  }

  .install-inner {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .intro-title {
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--color-text);
    letter-spacing: 0.012em;
  }

  /* 箱は中央・中の本文は左揃え（LP の各セクションと統一・2026-07-28）。
     中央揃えのままだと実機幅で「います。」「てください。」のように行末が1〜2文字だけ残り、
     行頭もばらついて読みにくかった（実機スクショで確認）。 */
  .intro-lead {
    max-width: 560px;
    text-align: left;
    font-size: var(--fs-body);
    line-height: 1.9;
    color: var(--color-text-muted);
  }

  /* ── 所要時間の先出し ── */
  .intro-time {
    width: 100%;
    max-width: 560px;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    text-align: left;
  }

  .intro-time-title {
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .intro-time-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .intro-time-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .intro-time-device {
    flex: 0 0 auto;
    min-width: 4.5em;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--color-text);
  }

  .intro-time-body {
    flex: 1 1 14em;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .intro-time-note {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .intro-pick {
    max-width: 560px;
    text-align: left;
    margin-top: var(--space-sm);
    font-size: var(--fs-body);
    line-height: 1.8;
    color: var(--color-text);
  }

  .intro-pick-note {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  /* ── 端末を選ぶジャンプボタン ── */
  .intro-jump {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    max-width: 360px;
  }

  .intro-jump .btn {
    width: 100%;
    text-align: center;
  }

  /* ── 端末カード ── */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  /* Android 端末で開いたときだけ Android カードを先頭へ。
     2カラムになるタブレット以上では並びを変えない（左右が入れ替わるだけで利得が無いため）。 */
  @media (max-width: 767px) {
    .cards.android-first #android {
      order: -1;
    }
  }

  .card {
    /* ジャンプボタンで飛んだとき、見出しが画面のきわに貼り付かないようにする */
    scroll-margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-xl);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .card-emoji {
    font-size: 28px;
    line-height: 1;
  }

  .card-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-text);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .step-num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-accent-text);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
  }

  .step-text {
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-text);
    padding-top: 2px;
  }

  .step-sub {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  /* ── スクショ付きステップ（iPhone） ── */
  .steps-shots {
    gap: var(--space-xl);
  }

  .step-shot {
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  /* スクショ付きステップの説明文。**手順を追いながら読む文章**なので読みやすさを優先し、
     箱は中央のまま中を左揃えにした（2026-07-28）。旧クラス名 .step-text-center は挙動と
