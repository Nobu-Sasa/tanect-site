---
// リリースノート（更新情報）ページ（/release-notes）
//
// 家族モニター向け。/install ページからリンクする身内向けページ。
// /home/ 配下は検索に載せない（config.ts の INDEXABLE_PATHS に未掲載＝BaseLayout が自動で noindex,nofollow）。
//
// 内容の出典：tanect-management の参照先 ~/src/Tanect2-1/Tanect2/CHANGELOG.md
//   （開発者向けの技術記述を、利用者向けの言葉に翻訳して載せる）
//
// 📌 掲載範囲の方針（2026-07-30 に変更）
//   以前は 1.9.0 以降の全バージョンを積み上げていたが、量が多く読みにくくなったため
//   **「最新バージョンの変更内容だけを載せる」**方針に切り替えた（1.15.8 以前の記述はこのとき削除）。
//   削除した過去分は git 履歴に残っている（`git log -- src/pages/home/release-notes.astro`）。
//   新しい版を出すときは、原則 changes を**その版の内容だけに置き換える**
//   （前の版がまだ全員に行き渡っていない等の事情があるときだけ、1つ前の版を残す）。
//
// 掲載中：
//   ※ 1.16.0（2026-07-23）家族の背景写真設定・初回ホームでお天気位置情報の案内・カレンダーに地名表示／
//     起動高速化・アプリ復帰時のもたつき解消・メール入力改善／予定の種類が空・音声入力失敗時の無反応の修正。
//     Android は 2026-07-24 配布、iOS は 2026-07-30 TestFlight 承認。
//
// ⚠️ 公開のたびに見直す箇所：
//   - currentVersions … いま各ストア／配布で公開中のバージョンと公開日
//   - LATEST_VERSION / LATEST_DATE … 下の変更表の見出しに出るバージョンと日付
//   - changes … 利用者向けの変更内容（新しい版の内容に置き換える）
//   - PREV_VERSION … 「◯◯からの変更点」の起点（前回このページに載せた版）
import BaseLayout from '../../layouts/BaseLayout.astro';

const HOME_URL = import.meta.env.BASE_URL.replace(/\/$/, '') + '/home/';
const INSTALL_URL = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/home/install`;

// ── いま公開中のバージョン（公開のたびに更新） ──
// date は「実際にモニターへ配布／公開した日」。未確定のうちは '—' のままでOK。
const currentVersions = [
  { os: 'iPhone（iOS）', emoji: '🍎', version: '1.16.0', date: '2026-07-30', note: '最新版' },
  { os: 'Android', emoji: '🤖', version: '1.16.0', date: '2026-07-24', note: '最新版' },
];

// ── 1.16.0 の変更内容（1.15.8 からの差分） ──
const LATEST_VERSION = '1.16.0';
const LATEST_DATE = '2026-07-24'; // モニター配布日（Android）
const PREV_VERSION = '1.15.8';

// kind: 'new'（新機能） / 'improve'（改善） / 'fix'（修正）
const changes = [
  // ── 1.16.0（2026-07-24）──
  {
    kind: 'new',
    text: '家族グループを作るときに、家族の写真（背景画像）を設定できるようになりました。新規登録で家族を作ったあと、続けて家族の写真を選んで設定できるステップを追加しました。設定した写真は、ホームや「みんなの」画面の家族パネルの背景になり、はじめから自分たちらしい見た目になります。「あとで設定する」で飛ばすこともでき、その場合も「家族設定」からいつでも変更できます。',
  },
  {
    kind: 'new',
    text: '登録のあと、初めてホーム画面を開いたときに、お天気の位置情報の設定をご案内するようにしました。「個人設定」が自動で開いて「お天気の位置情報」の欄までスクロールし、「現在地を使う」ボタンをゆっくり点滅させてご案内します。ボタンを押すと、その場で位置情報がオンになり、現在地のお天気が表示されます（一度ご案内したあとは自動では開きません）。',
  },
  {
    kind: 'new',
    text: '「私の」画面のカレンダーに、お天気を取得している地点の地名（市区町村など）を表示するようにしました。「週／月」の切り替えの右側に薄く表示し、どこのお天気かをひと目で確認できます。',
  },
  {
    kind: 'improve',
    text: 'アプリの起動が速くなりました。起動してから「私の」画面が表示されるまで約10秒かかっていましたが、起動時のスプラッシュ画面に毎回7秒の無駄な待ち時間が発生していたのを解消し、大幅に短縮しました。',
  },
  {
    kind: 'improve',
    text: '他のアプリから切り替えてアプリに戻ったときに、画面がすぐ表示されるようにしました。これまでは予定の一覧が一瞬消えてから読み込み直され、クルクル（読み込み中の表示）が出てもたつくことがありました。表示中の内容を保ったまま裏側で静かに最新化するようにし、チラつきを解消しました。あわせて、戻るたびのサーバーへの問い合わせの重複を整理し、通信を減らしました。',
  },
  {
    kind: 'improve',
    text: '新規登録で、メールアドレスを入力しやすくしました。最初のメールアドレス欄は貼り付けができるようにし（確認用の欄は打ち間違い防止のため手入力のまま）、2つの欄が一致しているかを入力中にその場で「✓ 一致しています／一致しません」と表示するようにしました。',
  },
  {
    kind: 'improve',
    text: '「承認をお待ちください」の画面に、やり直し方法のご案内を追加しました。招待コードでの参加を選ぶとこの画面で承認を待ちますが、承認する管理者がいないと待ち続けてしまうことがありました。「ご自身で新しく家族グループを作りたい場合は『家族を離れる』を押すと最初からやり直せます」とご案内します。',
  },
  {
    kind: 'improve',
    text: '「お天気の位置情報」を、位置情報機能がオフのままでも設定できるようにしました。オフのまま「現在地を使う」を押した場合は、位置情報をオンにする操作と現在地の取得をまとめて行います。あわせて、個人設定でお天気の位置情報を変更すると、「私の」画面のお天気・地名がすぐに反映されるようにしました。',
  },
  {
    kind: 'fix',
    text: '新しく登録した直後などに、予定の「種類」が選べない（一覧が空になる）ことがある問題を修正しました。最初のデータ取得がうまくいかなかった場合は、その場で自動的に取り直すようにしました。',
  },
  {
    kind: 'fix',
    text: '音声入力がうまくいかなかったとき、画面に何も表示されないことがある問題を修正しました。うまく録音できなかったときや、お声を聞き取れなかったとき（無音・まわりの音だけだった場合など）に、「お声を聞き取れませんでした。もう一度お話しください。」などとご案内し、次にどうすればよいかが分かるようにしました。',
  },
];

const kindLabel: Record<string, { text: string; cls: string }> = {
  new: { text: '新機能', cls: 'tag-new' },
  improve: { text: '改善', cls: 'tag-improve' },
  fix: { text: '修正', cls: 'tag-fix' },
};
---

<BaseLayout
  title="更新情報（リリースノート） — Tanect Home"
  description="Tanect Home のバージョンごとの更新内容のご案内です。"
>
  <header class="page-head">
    <a href={HOME_URL} class="logo" aria-label="Tanect Home トップへ">
      <img
        class="logo-mark"
        src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/app-icon.png`}
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="logo-text">Tanect<span class="logo-home"> Home</span></span>
    </a>
  </header>

  <main class="notes">
    <div class="notes-inner">
      <section class="intro">
        <span class="badge">📓 更新情報</span>
        <h1 class="intro-title">アプリの更新内容</h1>
        <p class="intro-lead">
          Tanect Home の最新バージョンの更新内容をご案内しています。<br />
          いつも使ってくださり、ありがとうございます。
        </p>
      </section>

      <!-- 現在公開中のバージョン -->
      <section class="current" aria-labelledby="current-title">
        <h2 class="section-title" id="current-title">いま公開中のバージョン</h2>
        <div class="table-wrap">
          <table class="ver-table">
            <thead>
              <tr>
                <th scope="col">端末</th>
                <th scope="col">バージョン</th>
                <th scope="col">公開日</th>
                <th scope="col" class="col-note">補足</th>
              </tr>
            </thead>
            <tbody>
              {currentVersions.map((v) => (
                <tr>
                  <td>
                    <span class="os-emoji" aria-hidden="true">{v.emoji}</span>
                    {v.os}
                  </td>
                  <td class="ver-num">{v.version}</td>
                  <td>{v.date}</td>
                  <td class="col-note">{v.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="current-note">
          iPhone 版は審査の都合で、Android 版より少し遅れて最新版になることがあります。
        </p>
      </section>

      <!-- バージョンごとの変更内容 -->
      <section class="release" aria-labelledby="release-title">
        <div class="release-head">
          <h2 class="section-title" id="release-title">バージョン {LATEST_VERSION} の変更内容</h2>
          <span class="release-date">{LATEST_DATE}</span>
        </div>
        <p class="release-sub">
          前のバージョン {PREV_VERSION} からの変更点です。<br />
          読みやすさのため、これより前のバージョンの更新内容は掲載を終了しました。
        </p>

        <ul class="change-list">
          {changes.map((c) => (
            <li class="change-item">
              <span class={`tag ${kindLabel[c.kind].cls}`}>{kindLabel[c.kind].text}</span>
              <span class="change-text">{c.text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="foot-links">
        <a href={INSTALL_URL} class="foot-link">📲 インストール方法を見る</a>
        <a href={HOME_URL} class="foot-link">← Tanect Home のトップへもどる</a>
      </section>
    </div>
  </main>

  <footer class="page-foot">
    <p class="page-foot-copy">© 2026 Tanect</p>
  </footer>
</BaseLayout>

<style>
  /* ── ヘッダー（最小：ロゴのみ） ── */
  .page-head {
    border-bottom: 1px solid var(--color-border-subtle);
    background: rgba(255, 255, 255, 0.9);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-md);
    font-weight: 700;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: block;
  }

  .logo-text {
    font-size: 20px;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  /* ── 本文 ── */
  .notes {
    padding: var(--space-3xl) var(--space-md);
    background: linear-gradient(180deg, var(--color-accent-soft) 0%, #ffffff 280px);
  }

  .notes-inner {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .intro-title {
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--color-text);
    letter-spacing: 0.012em;
  }

  .intro-lead {
    font-size: var(--fs-body);
    line-height: 1.9;
    color: var(--color-text-muted);
  }

  .section-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-text);
  }

  /* ── 現在公開中のバージョン ── */
  .current {
    margin-bottom: var(--space-3xl);
  }

  .table-wrap {
    margin-top: var(--space-md);
    overflow-x: auto;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-card-bg);
  }

  .ver-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .ver-table th,
  .ver-table td {
    padding: var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
    white-space: nowrap;
  }

  .ver-table thead th {
    background: var(--color-bg-soft);
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .ver-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .os-emoji {
    margin-right: 6px;
  }

  .ver-num {
    font-weight: 700;
    color: var(--color-accent-ink);
  }

  .col-note {
    color: var(--color-text-muted);
    font-size: 13px;
    white-space: normal;
  }

  .current-note {
    margin-top: var(--space-md);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  /* ── 変更内容 ── */
  .release-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .release-date {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .release-sub {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-lg);
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .change-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .change-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
  }

  .tag-new {
    background: #e8f3e1;
    color: #4f7a3a;
  }

  .tag-improve {
    background: var(--color-accent-soft);
    color: var(--color-accent-ink);
  }

  .tag-fix {
    background: #eceef2;
    color: #5a6172;
  }

  .change-text {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text);
    padding-top: 2px;
  }

  /* ── 下部リンク ── */
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    justify-content: center;
    margin-top: var(--space-3xl);
  }

  .foot-link {
    display: inline-block;
    font-size: 14px;
    color: var(--color-accent-ink);
    text-decoration: underline;
  }

  /* ── フッター ── */
  .page-foot {
    padding: var(--space-xl) var(--space-md);
    text-align: center;
    border-top: 1px solid var(--color-border-subtle);
  }

  .page-foot-copy {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  /* ── Tablet and up ── */
  @media (min-width: 768px) {
    .intro-title {
      font-size: var(--fs-h1-lg);
    }
  }
</style>
