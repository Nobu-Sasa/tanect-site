---
// リリースノート（更新情報）ページ（/release-notes）
//
// 家族モニター向け。/install ページからリンクする身内向けページ。
// /home/ 配下は検索に載せない（config.ts の INDEXABLE_PATHS に未掲載＝BaseLayout が自動で noindex,nofollow）。
//
// 内容の出典：tanect-management の参照先 ~/src/Tanect2-1/Tanect2/CHANGELOG.md
//   （開発者向けの技術記述を、利用者向けの言葉に翻訳して載せる）
//
// 📌 掲載範囲の方針（2026-07-30 に変更）
//   以前は 1.9.0 以降の全バージョンを積み上げていたが、量が多く読みにくくなったため
//   **「最新バージョンの変更内容だけを載せる」**方針に切り替えた（1.15.8 以前の記述はこのとき削除）。
//   削除した過去分は git 履歴に残っている（`git log -- src/pages/home/release-notes.astro`）。
//   新しい版を出すときは、原則 changes を**その版の内容だけに置き換える**
//   （前の版がまだ全員に行き渡っていない等の事情があるときだけ、1つ前の版を残す）。
//
// 掲載中：
//   ※ 1.18.0（2026-08-08）新機能「かんたん表示」。Android 配布済み／iOS は TestFlight 審査へ提出。
//   ※ 1.17.2（2026-08-07）「写真を撮る」でカメラが起動しない問題の修正。Android のみ先行配布。
//   ※ 1.17.1（2026-08-07）プラン選択画面・家族グループのまとめ（バンドル）ほか。
//     1.17.0 / 1.17.1 は単独ではモニターへ配布しなかったため、1.17.2 に含めて掲載している。
//   🔴 1.18.0 掲載時も 1.17.2 / 1.17.1 を残している（＝「1つ前の版を残す」例外の適用）。
//     理由：iOS は 1.16.0 で止まっており、1.17.x をまだ受け取っていないため。
//     PREV_VERSION を 1.16.3 のままにしているのもこのため（iOS 側の実際の起点に合わせる）。
//     iOS が 1.18.0 に追いついたら、次回更新で 1.17.x のブロックを落としてよい。
//   ※ 1.16.3 / 1.16.2（2026-08-02 / 07-27）の内容は 1.17.2 掲載時に削除（git 履歴に残る）。
//     Android 2026-08-02 配布済み。iOS は 1.16.0 据え置き（1.16.3 以降は Android 先行）。
//
// ⚠️ 公開のたびに見直す箇所：
//   - currentVersions … いま各ストア／配布で公開中のバージョンと公開日
//   - LATEST_VERSION / LATEST_DATE … 下の変更表の見出しに出るバージョンと日付
//   - changes … 利用者向けの変更内容（新しい版の内容に置き換える）
//   - PREV_VERSION … 「◯◯からの変更点」の起点（前回このページに載せた版）
import BaseLayout from '../../layouts/BaseLayout.astro';

const HOME_URL = import.meta.env.BASE_URL.replace(/\/$/, '') + '/home/';
const INSTALL_URL = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/home/install`;

// ── いま公開中のバージョン（公開のたびに更新） ──
// date は「実際にモニターへ配布／公開した日」。未確定のうちは '—' のままでOK。
const currentVersions = [
  { os: 'iPhone（iOS）', emoji: '🍎', version: '1.16.0', date: '2026-07-30', note: '1.18.0 を審査に提出中' },
  { os: 'Android', emoji: '🤖', version: '1.18.0', date: '2026-08-08', note: '最新版' },
];

// ── 1.18.0 の変更内容（1.17.2 / 1.17.1 の内容も併載・上のコメント参照） ──
const LATEST_VERSION = '1.18.0';
const LATEST_DATE = '2026-08-08'; // モニター配布日（Android）
const PREV_VERSION = '1.16.3';

// kind: 'new'（新機能） / 'improve'（改善） / 'fix'（修正）
const changes = [
  // ── 1.18.0（2026-08-08）──
  {
    kind: 'new',
    text: '「かんたん表示」を追加しました（個人設定の「表示設定」。これまでの「やさしい操作モード」を作り直したものです）。オンにすると画面が「みんなの」1つだけになり、下のメニューが消えます。ご高齢の方が迷わずお使いになれることを狙った表示です。設定はご家族（サポーター）が代理設定から切り替えていただけます。',
  },
  {
    kind: 'new',
    text: 'かんたん表示に「きょう」を追加しました。今日の日付と時刻を大きく表示し、その日アプリを開いたご家族のお名前が緑に光ります。ご自分が開いた瞬間にもご自分のお名前が光るので、「開いただけで家族に届いた」ことが分かります。いいねをくださった方には👍が付きます。',
  },
  {
    kind: 'new',
    text: 'かんたん表示の「今週の写真」では、写真を大きく並べ、タップするとすぐ拡大表示になります。どなたの投稿かとコメントを大きな文字で表示し、大きな「もどる」ボタンで戻れます。今日投稿された写真は緑の枠で分かります。',
  },
  {
    kind: 'new',
    text: 'かんたん表示の「今週の家族」では、画面の一番下から過去のレポートを開けます。ダイアログの一番上に大きな「音声で聞く」ボタンを置いたので、文章を読まなくても内容が分かります。',
  },
  {
    kind: 'new',
    text: 'かんたん表示では、ご予定の時刻を過ぎると「〇時に〇〇が予定されています。ご入力をお願いします」とお伝えします（1つのご予定につき1回だけ。個人設定の「私のアラーム」がオフのときは表示しません）。',
  },
  {
    kind: 'improve',
    text: '写真の拡大表示に、どなたの投稿かを表示するようにしました。',
  },
  {
    kind: 'improve',
    text: 'ご家族が代理設定で「かんたん表示」や文字サイズを変更したとき、その端末で開き直さなくてもすぐ反映されるようになりました。',
  },
  {
    kind: 'improve',
    text: 'かんたん表示のとき、右上のメニューを「個人設定・お問い合わせ・お問い合わせ履歴・ログアウト」に絞りました。設定を戻す・退会する・お問い合わせをするための入り口は残しています。',
  },
  {
    kind: 'fix',
    text: '「今週の家族」の過去のレポートを閉じたときに、エラーが表示されることがあった問題を修正しました。',
  },
  {
    kind: 'fix',
    text: 'かんたん表示に設定されているのに、ログインした直後は下のメニューが表示されてしまう問題を修正しました。',
  },
  // ── 1.17.2（2026-08-07）──
  {
    kind: 'fix',
    text: '一部の機種で、「写真を撮る」を押してもカメラが起動しない問題を修正しました。「ペットの様子」や活動の記録で撮影のボタンを押しても何も起こらず、写真を撮れないことがありました。アプリから端末のカメラアプリを呼び出すために必要な設定が足りておらず、機種によってはカメラアプリを見つけられずにいたことが原因です。なお 1.16.3 より前は、この状態のときにアプリが終了していたため「撮影すると落ちる」という症状として現れていました。落ちる問題は 1.16.3 で解消していましたが、そのために隠れていたこちらの問題が残っていました。',
  },
  {
    kind: 'fix',
    text: '写真を撮れなかったときに、その理由がボタンのすぐ下に表示されるようにしました。これまでは画面の下のほうに小さく出るだけで、画面を下げないと気づけませんでした。',
  },
  {
    kind: 'fix',
    text: 'Android で写真の許可についてご案内するとき、iPhone 向けの手順を表示していた問題を修正しました。お使いの端末に合わせた手順をご案内します。',
  },
  // ── 1.17.0 / 1.17.1（2026-08-07）※単独では配布しなかったため、1.17.2 に含めてご案内します ──
  {
    kind: 'new',
    text: 'プラン選択画面を追加しました。個人設定の「プラン」から、ご契約の内容と次回更新日の確認、プランの変更ができます（基本・上位・プレミアムの3種類。お値段はストアの表示に従います）。購入の復元と、利用規約・プライバシーポリシーへのご案内も、この画面からご利用いただけます。',
  },
  {
    kind: 'new',
    text: '上位・プレミアムプランで、複数の家族グループを1つのご契約にまとめられるようになりました。プラン選択画面の「このご契約で使える家族グループ」から追加・変更できます。2つの家族グループに入っている方は、お席を1つだけお使いになります（家族グループをまとめても、記録が混ざることはありません）。空き枠があるときは、新しく作った家族グループが自動的にご契約に加わります。',
  },
  {
    kind: 'new',
    text: '利用規約を追加しました。アプリ内でいつでも全文をご覧いただけます。',
  },
  {
    kind: 'improve',
    text: 'プランのお手続きは、お支払い担当（未設定の場合はまとめ役）の方だけが行えるようにしました。',
  },
  {
    kind: 'improve',
    text: 'プランを下げるご予約をされたとき、次回の更新で家族グループが減る場合には、事前にお知らせするようにしました。',
  },
  {
    kind: 'fix',
    text: 'ご利用期間が終了したあと、有料または無料お試しでご利用中の方がアプリからお手続きできず、復帰できない問題を修正しました。終了のお知らせから「プランを見る」で、そのままお手続きいただけます。',
  },
  {
    kind: 'fix',
    text: '有料でご契約中の方に「モニター期間が終了しました」と表示されることがある問題を修正しました。複数のご家族に参加されている場合も、有料のご契約を優先してご案内します。',
  },
  {
    kind: 'fix',
    text: 'ご利用期間の予告・猶予・終了のお知らせと、週次のふりかえりのお知らせが届かない問題を修正しました。',
  },
  {
    kind: 'fix',
    text: '予定の代理登録をお願いしている場合に、ご本人が登録された予定をサポーターの方が削除できてしまうことがある問題を修正しました。ご本人が登録された予定は、これまでどおりご本人だけが削除できます。',
  },
  {
    kind: 'fix',
    text: '「過去の活動をクリア」を使ったあと、くり返しの予定がしばらくのあいだ登録した日から始まらない問題を修正しました。クリアの対象はこれまでどおり過去の記録だけで、これからのご予定はきちんと並びます。',
  },
];

const kindLabel: Record<string, { text: string; cls: string }> = {
  new: { text: '新機能', cls: 'tag-new' },
  improve: { text: '改善', cls: 'tag-improve' },
  fix: { text: '修正', cls: 'tag-fix' },
};
---

<BaseLayout
  title="更新情報（リリースノート） — Tanect Home"
  description="Tanect Home のバージョンごとの更新内容のご案内です。"
>
  <header class="page-head">
    <a href={HOME_URL} class="logo" aria-label="Tanect Home トップへ">
      <img
        class="logo-mark"
        src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/app-icon.png`}
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="logo-text">Tanect<span class="logo-home"> Home</span></span>
    </a>
  </header>

  <main class="notes">
    <div class="notes-inner">
      <section class="intro">
        <span class="badge">📓 更新情報</span>
        <h1 class="intro-title">アプリの更新内容</h1>
        <p class="intro-lead">
          Tanect Home の最新バージョンの更新内容をご案内しています。<br />
          いつも使ってくださり、ありがとうございます。
        </p>
      </section>

      <!-- 現在公開中のバージョン -->
      <section class="current" aria-labelledby="current-title">
        <h2 class="section-title" id="current-title">いま公開中のバージョン</h2>
        <div class="table-wrap">
          <table class="ver-table">
            <thead>
              <tr>
                <th scope="col">端末</th>
                <th scope="col">バージョン</th>
                <th scope="col">公開日</th>
                <th scope="col" class="col-note">補足</th>
              </tr>
            </thead>
            <tbody>
              {currentVersions.map((v) => (
                <tr>
                  <td>
                    <span class="os-emoji" aria-hidden="true">{v.emoji}</span>
                    {v.os}
                  </td>
                  <td class="ver-num">{v.version}</td>
                  <td>{v.date}</td>
                  <td class="col-note">{v.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="current-note">
          iPhone 版は審査の都合で、Android 版より少し遅れて最新版になることがあります。
        </p>
      </section>

      <!-- バージョンごとの変更内容 -->
      <section class="release" aria-labelledby="release-title">
        <div class="release-head">
          <h2 class="section-title" id="release-title">バージョン {LATEST_VERSION} の変更内容</h2>
          <span class="release-date">{LATEST_DATE}</span>
        </div>
        <p class="release-sub">
          前のバージョン {PREV_VERSION} からの変更点です。<br />
          読みやすさのため、これより前のバージョンの更新内容は掲載を終了しました。
        </p>

        <ul class="change-list">
          {changes.map((c) => (
            <li class="change-item">
              <span class={`tag ${kindLabel[c.kind].cls}`}>{kindLabel[c.kind].text}</span>
              <span class="change-text">{c.text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="foot-links">
        <a href={INSTALL_URL} class="foot-link">📲 インストール方法を見る</a>
        <a href={HOME_URL} class="foot-link">← Tanect Home のトップへもどる</a>
      </section>
    </div>
  </main>

  <footer class="page-foot">
    <p class="page-foot-copy">© 2026 Tanect</p>
  </footer>
</BaseLayout>

<style>
  /* ── ヘッダー（最小：ロゴのみ） ── */
  .page-head {
    border-bottom: 1px solid var(--color-border-subtle);
    background: rgba(255, 255, 255, 0.9);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-md);
    font-weight: 700;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: block;
  }

  .logo-text {
    font-size: 20px;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  /* ── 本文 ── */
  .notes {
    padding: var(--space-3xl) var(--space-md);
    background: linear-gradient(180deg, var(--color-accent-soft) 0%, #ffffff 280px);
  }

  .notes-inner {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .intro-title {
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--color-text);
    letter-spacing: 0.012em;
  }

  .intro-lead {
    font-size: var(--fs-body);
    line-height: 1.9;
    color: var(--color-text-muted);
  }

  .section-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-text);
  }

  /* ── 現在公開中のバージョン ── */
  .current {
    margin-bottom: var(--space-3xl);
  }

  .table-wrap {
    margin-top: var(--space-md);
    overflow-x: auto;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-card-bg);
  }

  .ver-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .ver-table th,
  .ver-table td {
    padding: var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
    white-space: nowrap;
  }

  .ver-table thead th {
    background: var(--color-bg-soft);
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .ver-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .os-emoji {
    margin-right: 6px;
  }

  .ver-num {
    font-weight: 700;
    color: var(--color-accent-ink);
  }

  .col-note {
    color: var(--color-text-muted);
    font-size: 13px;
    white-space: normal;
  }

  .current-note {
    margin-top: var(--space-md);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  /* ── 変更内容 ── */
  .release-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .release-date {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .release-sub {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-lg);
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .change-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .change-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
  }

  .tag-new {
    background: #e8f3e1;
    color: #4f7a3a;
  }

  .tag-improve {
    background: var(--color-accent-soft);
    color: var(--color-accent-ink);
  }

  .tag-fix {
    background: #eceef2;
    color: #5a6172;
  }

  .change-text {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text);
    padding-top: 2px;
  }

  /* ── 下部リンク ── */
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    justify-content: center;
    margin-top: var(--space-3xl);
  }

  .foot-link {
    display: inline-block;
    font-size: 14px;
    color: var(--color-accent-ink);
    text-decoration: underline;
  }

  /* ── フッター ── */
  .page-foot {
    padding: var(--space-xl) var(--space-md);
    text-align: center;
    border-top: 1px solid var(--color-border-subtle);
  }

  .page-foot-copy {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  /* ── Tablet and up ── */
  @media (min-width: 768px) {
    .intro-title {
      font-size: var(--fs-h1-lg);
    }
  }
</style>
