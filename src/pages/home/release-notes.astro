---
// リリースノート（更新情報）ページ（/release-notes）
//
// 家族モニター向け。/install ページからリンクする身内向けページ。
// /home/ 配下は検索に載せない（config.ts の INDEXABLE_PATHS に未掲載＝BaseLayout が自動で noindex,nofollow）。
//
// 内容の出典：tanect-management の参照先 ~/src/Tanect2-1/Tanect2/CHANGELOG.md
//   （開発者向けの技術記述を、利用者向けの言葉に翻訳して載せる）
//
// 📌 掲載範囲の方針（2026-07-30 に変更）
//   以前は 1.9.0 以降の全バージョンを積み上げていたが、量が多く読みにくくなったため
//   **「最新バージョンの変更内容だけを載せる」**方針に切り替えた（1.15.8 以前の記述はこのとき削除）。
//   削除した過去分は git 履歴に残っている（`git log -- src/pages/home/release-notes.astro`）。
//   新しい版を出すときは、原則 changes を**その版の内容だけに置き換える**
//   （前の版がまだ全員に行き渡っていない等の事情があるときだけ、1つ前の版を残す）。
//
// 掲載中：
//   ※ 1.19.0（2026-08-13）かんたん表示で写真からそのまま「いいね！」・ヘッダー長押しで切替。
//     Android 配布済み／iOS は TestFlight 審査へ提出。
//   ※ 1.18.2（2026-08-10）お知らせ（今週の家族・予定）まわりの不具合修正。
//     1.18.2 は単独ではモニターへ配布しなかったため、1.19.0 に含めて掲載している。
//   ✅ 2026-08-13 更新時に 1.18.1 / 1.18.0 / 1.17.2 / 1.17.1 のブロックを削除（git 履歴に残る）。
//     理由：iOS が 2026-08-10 に 1.18.1 を受け取り、Android に追いついたため
//     （＝「1つ前の版を残す」例外の解除。PREV_VERSION も 1.16.3 → 1.18.1 へ戻した）。
//
// ⚠️ 公開のたびに見直す箇所：
//   - currentVersions … いま各ストア／配布で公開中のバージョンと公開日
//   - LATEST_VERSION / LATEST_DATE … 下の変更表の見出しに出るバージョンと日付
//   - changes … 利用者向けの変更内容（新しい版の内容に置き換える）
//   - PREV_VERSION … 「◯◯からの変更点」の起点（前回このページに載せた版）
import BaseLayout from '../../layouts/BaseLayout.astro';

const HOME_URL = import.meta.env.BASE_URL.replace(/\/$/, '') + '/home/';
const INSTALL_URL = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/home/install`;

// ── いま公開中のバージョン（公開のたびに更新） ──
// date は「実際にモニターへ配布／公開した日」。未確定のうちは '—' のままでOK。
const currentVersions = [
  { os: 'iPhone（iOS）', emoji: '🍎', version: '1.18.1', date: '2026-08-10', note: '1.19.0 を審査に提出中' },
  { os: 'Android', emoji: '🤖', version: '1.19.0', date: '2026-08-13', note: '最新版' },
];

// ── 1.19.0 の変更内容（1.18.2 の内容も併載・上のコメント参照） ──
const LATEST_VERSION = '1.19.0';
const LATEST_DATE = '2026-08-13'; // モニター配布日（Android）
const PREV_VERSION = '1.18.1';

// kind: 'new'（新機能） / 'improve'（改善） / 'fix'（修正）
const changes = [
  // ── 1.19.0（2026-08-13）──
  {
    kind: 'new',
    text: 'かんたん表示で写真を大きく表示したとき、その場で「いいね！」を押せるようにしました。ご家族の写真を見ながら、画面を戻さずに気持ちを届けられます（もう一度押すと取り消せます）。',
  },
  {
    kind: 'new',
    text: 'かんたん表示でご自身の写真を大きく表示したとき、どなたが「いいね！」をくださったかをお名前で表示するようにしました。',
  },
  {
    kind: 'new',
    text: '画面いちばん上の「Tanect Home」を長押し（1.5秒）すると、「かんたん表示」のオン・オフを切り替えられるようにしました。確認のおたずねが出てから切り替わるので、うっかり触っても切り替わりません。かんたん表示のときも、同じ操作で元の表示に戻せます。',
  },
  {
    kind: 'improve',
    text: 'パスワードを変更・再設定したとき、それ以前にログインしていた端末が、その場でログアウトされるようにしました。これまでは再設定のあとも、古い端末からしばらくアクセスできる状態が残っていました。万一パスワードを知られてしまったときも、再設定で確実に締め出せます。',
  },
  // ── 1.18.2（2026-08-10）※単独では配布しなかったため、1.19.0 に含めてご案内します ──
  {
    kind: 'fix',
    text: '「今週の家族」を読んだあとも、お知らせの「今週の家族が届きました」が消えないことがある問題を修正しました。ご家族グループを2つ以上お持ちの場合に、選んでいるご家族以外のレポートを開いても「読んだ」ことが記録されず、アプリを開き直してもお知らせが残り続けていました。',
  },
  {
    kind: 'fix',
    text: 'かんたん表示で「今週の家族」を読んだときに、その場でお知らせが消えるようにしました（これまでは画面を切り替えるまで残っていました）。',
  },
  {
    kind: 'improve',
    text: 'お知らせの「今週の家族が届きました」をタップしたとき、まだ読んでいないレポートのあるご家族の画面へ直接開くようにしました。',
  },
  {
    kind: 'fix',
    text: 'かんたん表示でお知らせをタップすると、戻れない画面に移動してしまう問題を修正しました。予定のお知らせをタップすると、みんなの画面のままその予定の記録画面が開きます。ご家族が代わりに登録してくださった予定のお知らせでは、いつ・何が追加されたかをその場でお伝えします。お問い合わせの返信や承認のお願いなど、そのほかのお知らせでも、みんなの画面から出られなくなることがなくなりました。',
  },
  {
    kind: 'fix',
    text: 'ご利用期間が終了したご家族のレポートを、お知らせの件数に数えないようにしました。かんたん表示の一覧には出ないため、これまでは開いて消すことのできないお知らせが残っていました（閲覧のみの期間中のご家族は、これまでどおりお知らせします）。',
  },
];

const kindLabel: Record<string, { text: string; cls: string }> = {
  new: { text: '新機能', cls: 'tag-new' },
  improve: { text: '改善', cls: 'tag-improve' },
  fix: { text: '修正', cls: 'tag-fix' },
};
---

<BaseLayout
  title="更新情報（リリースノート） — Tanect Home"
  description="Tanect Home のバージョンごとの更新内容のご案内です。"
>
  <header class="page-head">
    <a href={HOME_URL} class="logo" aria-label="Tanect Home トップへ">
      <img
        class="logo-mark"
        src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/app-icon.png`}
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="logo-text">Tanect<span class="logo-home"> Home</span></span>
    </a>
  </header>

  <main class="notes">
    <div class="notes-inner">
      <section class="intro">
        <span class="badge">📓 更新情報</span>
        <h1 class="intro-title">アプリの更新内容</h1>
        <p class="intro-lead">
          Tanect Home の最新バージョンの更新内容をご案内しています。<br />
          いつも使ってくださり、ありがとうございます。
        </p>
      </section>

      <!-- 現在公開中のバージョン -->
      <section class="current" aria-labelledby="current-title">
        <h2 class="section-title" id="current-title">いま公開中のバージョン</h2>
        <div class="table-wrap">
          <table class="ver-table">
            <thead>
              <tr>
                <th scope="col">端末</th>
                <th scope="col">バージョン</th>
                <th scope="col">公開日</th>
                <th scope="col" class="col-note">補足</th>
              </tr>
            </thead>
            <tbody>
              {currentVersions.map((v) => (
                <tr>
                  <td>
                    <span class="os-emoji" aria-hidden="true">{v.emoji}</span>
                    {v.os}
                  </td>
                  <td class="ver-num">{v.version}</td>
                  <td>{v.date}</td>
                  <td class="col-note">{v.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="current-note">
          iPhone 版は審査の都合で、Android 版より少し遅れて最新版になることがあります。
        </p>
      </section>

      <!-- バージョンごとの変更内容 -->
      <section class="release" aria-labelledby="release-title">
        <div class="release-head">
          <h2 class="section-title" id="release-title">バージョン {LATEST_VERSION} の変更内容</h2>
          <span class="release-date">{LATEST_DATE}</span>
        </div>
        <p class="release-sub">
          前のバージョン {PREV_VERSION} からの変更点です。<br />
          読みやすさのため、これより前のバージョンの更新内容は掲載を終了しました。
        </p>

        <ul class="change-list">
          {changes.map((c) => (
            <li class="change-item">
              <span class={`tag ${kindLabel[c.kind].cls}`}>{kindLabel[c.kind].text}</span>
              <span class="change-text">{c.text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="foot-links">
        <a href={INSTALL_URL} class="foot-link">📲 インストール方法を見る</a>
        <a href={HOME_URL} class="foot-link">← Tanect Home のトップへもどる</a>
      </section>
    </div>
  </main>

  <footer class="page-foot">
    <p class="page-foot-copy">© 2026 Tanect</p>
  </footer>
</BaseLayout>

<style>
  /* ── ヘッダー（最小：ロゴのみ） ── */
  .page-head {
    border-bottom: 1px solid var(--color-border-subtle);
    background: rgba(255, 255, 255, 0.9);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-md);
    font-weight: 700;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: block;
  }

  .logo-text {
    font-size: 20px;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  /* ── 本文 ── */
  .notes {
    padding: var(--space-3xl) var(--space-md);
    background: linear-gradient(180deg, var(--color-accent-soft) 0%, #ffffff 280px);
  }

  .notes-inner {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .intro-title {
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--color-text);
    letter-spacing: 0.012em;
  }

  .intro-lead {
    font-size: var(--fs-body);
    line-height: 1.9;
    color: var(--color-text-muted);
  }

  .section-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-text);
  }

  /* ── 現在公開中のバージョン ── */
  .current {
    margin-bottom: var(--space-3xl);
  }

  .table-wrap {
    margin-top: var(--space-md);
    overflow-x: auto;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-card-bg);
  }

  .ver-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .ver-table th,
  .ver-table td {
    padding: var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
    white-space: nowrap;
  }

  .ver-table thead th {
    background: var(--color-bg-soft);
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .ver-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .os-emoji {
    margin-right: 6px;
  }

  .ver-num {
    font-weight: 700;
    color: var(--color-accent-ink);
  }

  .col-note {
    color: var(--color-text-muted);
    font-size: 13px;
    white-space: normal;
  }

  .current-note {
    margin-top: var(--space-md);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  /* ── 変更内容 ── */
  .release-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .release-date {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .release-sub {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-lg);
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .change-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .change-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
  }

  .tag-new {
    background: #e8f3e1;
    color: #4f7a3a;
  }

  .tag-improve {
    background: var(--color-accent-soft);
    color: var(--color-accent-ink);
  }

  .tag-fix {
    background: #eceef2;
    color: #5a6172;
  }

  .change-text {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text);
    padding-top: 2px;
  }

  /* ── 下部リンク ── */
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    justify-content: center;
    margin-top: var(--space-3xl);
  }

  .foot-link {
    display: inline-block;
    font-size: 14px;
    color: var(--color-accent-ink);
    text-decoration: underline;
  }

  /* ── フッター ── */
  .page-foot {
    padding: var(--space-xl) var(--space-md);
    text-align: center;
    border-top: 1px solid var(--color-border-subtle);
  }

  .page-foot-copy {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  /* ── Tablet and up ── */
  @media (min-width: 768px) {
    .intro-title {
      font-size: var(--fs-h1-lg);
    }
  }
</style>
