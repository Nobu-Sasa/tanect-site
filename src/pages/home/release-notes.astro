---
// リリースノート（更新情報）ページ（/release-notes）
//
// 家族モニター向け。/install ページからリンクする身内向けページ。
// /home/ 配下は検索に載せない（config.ts の INDEXABLE_PATHS に未掲載＝BaseLayout が自動で noindex,nofollow）。
//
// 内容の出典：tanect-management の参照先 ~/src/Tanect2-1/Tanect2/CHANGELOG.md
//   （開発者向けの技術記述を、利用者向けの言葉に翻訳して載せる）
//
// 📌 掲載範囲の方針（2026-07-30 制定／2026-08-23 改訂）
//   以前は 1.9.0 以降の全バージョンを積み上げていたが、量が多く読みにくくなったため
//   **「最新バージョンの変更内容だけを載せる」**方針に切り替えた（1.15.8 以前の記述はこのとき削除）。
//   削除した過去分は git 履歴に残っている（`git log -- src/pages/home/release-notes.astro`）。
//
//   【原則】新しい版を出すときは、changes を**その版の内容だけに置き換える**。
//
//   【残す条件・必ず守る】次のどちらかに当てはまるときは、**直前の版を消さない**。
//     🔴 ① **その版が片方のOSにしか出ない版**のとき（例：Android 専用の修正）。
//        もう一方のOSの利用者にとっては「自分に届いた最後の変更」が直前の版であり、
//        消すとページから自分の更新内容が消えてしまう。
//        （2026-08-23・1.19.4＝Android 専用のときに実際に起きて、1.19.3 を戻した）
//     ② 直前の版が**まだ全員に行き渡っていない**とき（片方のOSが審査中・未受領など）。
//
//   【削除してよい条件】**両OSがその版を受け取り、かつ次の版が両OSに出たとき**。
//     削除したら PREV_VERSION をその版に上げる。
//
//   【版をまたいで載せるとき】changes の各項目に **`ver`（版）を必ず入れる**。
//     項目の左に版が表示され、どれが今回の変更かが読み手に分かる。
//
// 掲載中：
//   ※ 1.21.10（Android は 2026-09-10 にモニター配布／iPhone は TestFlight 審査を通過し
//     2026-09-14 に「テスト中」を確認＝**両OSとも配信ずみ**）。
//     前回配信（両OSとも 1.21.1・2026-08-30）から **1.21.2 / 1.21.8 / 1.21.9 の3版が未配信のまま
//     積み上がっていた**ため、**1.21.2 / 1.21.8 / 1.21.9 / 1.21.10 の4版ぶんをすべて掲載している**（各項目に ver あり）。
//   ※ 1.21.1 のブロックは 2026-09-14 に削除した（両OSが 1.21.1 を受け取り、その後の版＝1.21.10 も
//     両OSへ出たため＝【削除してよい条件】を満たした）。PREV_VERSION は 1.21.1 に上げた。
//   ⚠️ iPhone の date は「テスト中」を nobu が確認した日。審査が通った実際の日はこれより前の可能性がある。
//   ※ 1.21.3〜1.21.7（build 84〜88）は欠番（実機で見え方を確かめるためだけのビルドで配布していない）。
//
// ⚠️ 公開のたびに見直す箇所：
//   - currentVersions … いま各ストア／配布で公開中のバージョンと公開日
//   - LATEST_VERSION / LATEST_DATE … 下の変更表の見出しに出るバージョンと日付
//   - changes … 利用者向けの変更内容（その版の内容に置き換える。ただし上の
//     【残す条件】に当てはまるときは直前の版を残し、各項目に ver を入れる）
//   - PREV_VERSION … 「◯◯からの変更点」の起点（いま載せている中でいちばん古い版の1つ前）
import BaseLayout from '../../layouts/BaseLayout.astro';

const HOME_URL = import.meta.env.BASE_URL.replace(/\/$/, '') + '/home/';
const INSTALL_URL = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/home/install`;

// ── いま公開中のバージョン（公開のたびに更新） ──
// date は「実際にモニターへ配布／公開した日」。未確定のうちは '—' のままでOK。
const currentVersions = [
  { os: 'iPhone（iOS）', emoji: '🍎', version: '1.21.10', date: '2026-09-14', note: '最新版' },
  { os: 'Android', emoji: '🤖', version: '1.21.10', date: '2026-09-10', note: '最新版' },
];

// ── 1.21.10 ＋ 未配信のままだった 1.21.9・1.21.8・1.21.2 の変更内容 ──
const LATEST_VERSION = '1.21.10';
const LATEST_DATE = '2026-09-10'; // Android へモニター配布した日（iPhone は 2026-09-14 に TestFlight でテスト中を確認）
const PREV_VERSION = '1.21.1'; // いま載せている中でいちばん古い版（1.21.2）の1つ前

// kind: 'new'（新機能） / 'improve'（改善） / 'fix'（修正）
// ver : どの版で入った変更か（項目の左に表示。複数の版を載せるときは必須）
const changes = [
  {
    ver: '1.21.10',
    kind: 'improve',
    text: 'アプリを開いたときの最初の画面（起動画面）の絵柄を揃えました。iPhone では、開いてすぐ出る絵と、そのあとに出る絵が違っていて、起動のたびに絵が一度切り替わって見えていました。同じ絵・同じ大きさにしたので、切り替わらずにそのまま開きます。絵柄は双葉と「コトバだより」です。Android は、はじめに出る丸い絵柄はこれまでどおり双葉で、そのあとに双葉と「コトバだより」が出ます。',
  },
  {
    ver: '1.21.10',
    kind: 'improve',
    text: '双葉のご案内が「あと何回で、どうなるか」に変わりました。これまでの「2日目です」に代えて、「あと2回の記録で、芽が出ます」とお伝えします。記録なさるたびに数が減っていきます。お世話のボタンから開く画面と「ただいまの記録」にも、同じご案内を大きくお出しします。炎の札はこれまでどおり「続いた日数」です。',
  },
  {
    ver: '1.21.10',
    kind: 'improve',
    text: '「今週のたより」の読み上げを、どなたでもお使いいただけるようになりました。これまでは一部のご契約でしか読み上げが出ませんでしたが、モニターのかた・無料でお使いのかたにも出ます。「私の」ふりかえり（おひとりぶん）でも読み上げが出ます。',
  },
  {
    ver: '1.21.10',
    kind: 'improve',
    text: '「今週のたより」の読み上げを、ボタンを押したときにご用意する方式にしました。初めて聴かれるときだけ、数秒お待ちいただきます（その間ボタンが「音声を準備しています」になります）。2回目からはすぐに始まります。聴ける内容・声・タイミングは変わりません。',
  },
  {
    ver: '1.21.10',
    kind: 'improve',
    text: '音声が聴けなかったときのご案内を、原因ごとに分けました。「しばらくたってからお試しください」と「通信状況をご確認ください」を区別してお伝えします。',
  },
  {
    ver: '1.21.10',
    kind: 'fix',
    text: '「みんなの」から、押しても表示が変わらない絞り込み「活動したもの」を外しました。「みんなの」に出るのは「した」と記録して投稿されたものだけで、予定や「しなかった」は出ないためです。見えるものは変わりません。絞り込みは「いいね！を押そう」だけになります。',
  },
  {
    ver: '1.21.10',
    kind: 'fix',
    text: '「今週のたより」の人気写真に、共有をやめたお写真が出ないようにしました。みんなの画面から取り下げたお写真が、いいねの数だけ順位に残り、写真が出ない枠になっていました。取り下げたお写真は順位からも外れます（その週の人気写真が2枚になることがあります）。',
  },
  {
    ver: '1.21.10',
    kind: 'fix',
    text: 'モニター期間が終わったあとも、ご自身でプランのお手続きに進めるようにしました。ご利用期間の終了をお知らせする画面に「プランを見る」のボタンが出ず、お問い合わせしかできない状態でした。',
  },
  {
    ver: '1.21.10',
    kind: 'fix',
    text: 'ご利用期間の終了をお知らせする画面の文言を、ご利用中のプランに合わせました。無料でお使いのかたやご契約中のかたにも「モニター期間が終了しました」と出ることがありました。',
  },
  {
    ver: '1.21.9',
    kind: 'improve',
    text: 'アプリの名前が「コトバだより」になりました。画面いちばん上のバーの表示と、スマートフォンのホーム画面に並ぶ名前が変わります。絵柄（アイコン）はこれまでと同じ双葉です。ホーム画面では、いつもの絵柄を目印にお探しください。これまでの記録・お写真・ご設定は、そのままお使いいただけます。',
  },
  {
    ver: '1.21.9',
    kind: 'improve',
    text: '毎週日曜に届く「今週のふりかえり」を「今週のたより」と呼ぶようにしました。アプリの名前「コトバだより」の「たより」と同じ言葉です。画面の見出し・お知らせ・通知の文言が変わり、「過去のふりかえりを見る」は「過去のたよりを見る」になります。内容や届くタイミング（日曜 朝9時）は変わりません。',
  },
  {
    ver: '1.21.9',
    kind: 'improve',
    text: '役割を「まとめ役」と「サポーター」の2つにしました。これまでの「お支払い担当」はなくしました。ご契約（プランのお申し込み・変更）は、まとめ役のかた（および、実際にお手続きなさったご本人）が行えます。これまで「お支払い担当」だったかたの権限が減ることはありません。',
  },
  {
    ver: '1.21.9',
    kind: 'improve',
    text: '「プラン」の入口を「個人設定」から「グループ設定」に移しました。ご契約はグループごとにお申し込みいただくものなので、グループをお選びになる画面に置きました。グループ設定で選んでいるグループが、そのままプランの画面にも引き継がれます。',
  },
  {
    ver: '1.21.9',
    kind: 'improve',
    text: 'かんたん表示の「今週のたより」で、ご自身だけの分の名前を「私の」にしました。グループがいくつかあるときに行頭が「個人」と出ていたのを、ほかの画面と同じ「私の」に揃えました。',
  },
  {
    ver: '1.21.9',
    kind: 'improve',
    text: 'お知らせの「承認依頼が◯件あります」をお押しになったときに、そのグループの「承認待ち」までご案内するようにしました。これまではグループ設定が開くだけで、別のグループが選ばれたままのことがありました。いくつかのグループに依頼があるときは、いちばん古い依頼のグループをご案内します。',
  },
  {
    ver: '1.21.9',
    kind: 'fix',
    text: 'おひとりでお使いのかたに「利用期間が終了します」のお知らせが届かないようにしました。おひとりで記録なさる場所（グループに入っていない「私の」記録）には、利用期限はありません。10月下旬から誤って届く状態になっていたため、事前に直しました。',
  },
  {
    ver: '1.21.9',
    kind: 'fix',
    text: 'ご利用期間が終わったあとの猶予中に「記録できません」と表示されていたのを直しました。実際には猶予の期間中もこれまでどおり記録していただけます。お知らせの文言も「あと◯日で停止します（記録はできます）」に改めました。',
  },
  {
    ver: '1.21.8',
    kind: 'improve',
    text: '「みんなの」の絞り込みボタンを軽くしました。「今日ひらいた方」の札が濃い緑で、いま押している札（オレンジ）より濃く見えていました。「今日ひらいた方」の札は「私の」画面の「ひとことメモ」と同じ緑に揃え、名前の文字はどちらの札も同じ黒にしました。押している札は押し込まれた見た目になります。かんたん表示の「きょう」パネルの、ご家族おひとりずつの窓も同じ見た目に揃えました。',
  },
  {
    ver: '1.21.2',
    kind: 'improve',
    text: '「自分のもの」の呼び方を「私の」に揃えました。「予定」「活動を見る」「個人設定」で、どなたのものかをお選びになる欄のご自身の行が、お名前ではなく「私の」と出ます。「今週のたより」でグループをお選びになるボタンも「私」から「私の」に変え、一番はじめに置きました。',
  },
  {
    ver: '1.21.2',
    kind: 'improve',
    text: '「個人設定」「グループ設定」を開いたときの、見出しの絵柄に色が付きました。右上のメニューと同じ色（個人＝緑／グループ＝橙）にして、押した先でも同じものだと分かるようにしました。',
  },
  {
    ver: '1.21.2',
    kind: 'improve',
    text: '「グループ設定」の「別のグループを作る / 参加する」を、画面の上のほうへ移しました。一番下にあって見つけにくかったためです。',
  },
  {
    ver: '1.21.2',
    kind: 'improve',
    text: '「個人設定」の「みんなの活動への共有」から「個人」を外しました。おひとりでお使いになるための入れ物なので、見せる相手がいない＝切り替えても何も変わらない項目でした。',
  },
  {
    ver: '1.21.2',
    kind: 'fix',
    text: '「個人設定」で「かんたん表示」を入りになさると、個人設定の画面が閉じてしまうことがあったのを直しました。切り替えは個人設定を閉じたあとに反映するようにしたので、続けてほかの設定も変えられます。あわせて「かんたん表示」の説明に、上のバーの「コトバだより」を2秒ほど長押しすると入り／切りを切り替えられることを書き添えました。',
  },

];

// 各項目の 1 文目（最初の「。」まで）を太字にして、拾い読みで用件が分かるようにする。
// 2文目以降は背景・詳細なので通常の太さのまま。「。」が無い項目は全文を 1 文目として扱う。
const splitLead = (text: string): [string, string] => {
  const i = text.indexOf('。');
  return i === -1 ? [text, ''] : [text.slice(0, i + 1), text.slice(i + 1)];
};

const kindLabel: Record<string, { text: string; cls: string }> = {
  new: { text: '新機能', cls: 'tag-new' },
  improve: { text: '改善', cls: 'tag-improve' },
  fix: { text: '修正', cls: 'tag-fix' },
};
---

<BaseLayout
  title="更新情報（リリースノート） — Tanect Home"
  description="Tanect Home のバージョンごとの更新内容のご案内です。"
>
  <header class="page-head">
    <a href={HOME_URL} class="logo" aria-label="Tanect Home トップへ">
      <img
        class="logo-mark"
        src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/app-icon.png`}
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="logo-text">Tanect<span class="logo-home"> Home</span></span>
    </a>
  </header>

  <main class="notes">
    <div class="notes-inner">
      <section class="intro">
        <span class="badge">📓 更新情報</span>
        <h1 class="intro-title">アプリの更新内容</h1>
        <p class="intro-lead">
          Tanect Home の最新バージョンの更新内容をご案内しています。<br />
          いつも使ってくださり、ありがとうございます。
        </p>
      </section>

      <!-- 現在公開中のバージョン -->
      <section class="current" aria-labelledby="current-title">
        <h2 class="section-title" id="current-title">いま公開中のバージョン</h2>
        <div class="table-wrap">
          <table class="ver-table">
            <thead>
              <tr>
                <th scope="col">端末</th>
                <th scope="col">バージョン</th>
                <th scope="col">公開日</th>
                <th scope="col" class="col-note">補足</th>
              </tr>
            </thead>
            <tbody>
              {currentVersions.map((v) => (
                <tr>
                  <td>
                    <span class="os-emoji" aria-hidden="true">{v.emoji}</span>
                    {v.os}
                  </td>
                  <td class="ver-num">{v.version}</td>
                  <td>{v.date}</td>
                  <td class="col-note">{v.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="current-note">
          iPhone 版は審査の都合で、Android 版より少し遅れて最新版になることがあります。
        </p>
      </section>

      <!-- バージョンごとの変更内容 -->
      <section class="release" aria-labelledby="release-title">
        <div class="release-head">
          <h2 class="section-title" id="release-title">バージョン {LATEST_VERSION} の変更内容</h2>
          <span class="release-date">{LATEST_DATE}</span>
        </div>
        <p class="release-sub">
          前のバージョン {PREV_VERSION} からの変更点です。<br />
          読みやすさのため、これより前のバージョンの更新内容は掲載を終了しました。
        </p>

        <ul class="change-list">
          {changes.map((c) => {
            const [lead, rest] = splitLead(c.text);
            return (
              <li class="change-item">
                <span class="change-badges">
                  <span class={`tag ${kindLabel[c.kind].cls}`}>{kindLabel[c.kind].text}</span>
                  {c.ver && <span class="change-ver">{c.ver}</span>}
                </span>
                {/* 空白が入ると 1 行目だけ字下がりして見えるので、strong は開始タグに続けて置く */}
                <span class="change-text"><strong class="change-lead">{lead}</strong>{rest}</span>
              </li>
            );
          })}
        </ul>
      </section>

      <section class="foot-links">
        <a href={INSTALL_URL} class="foot-link">📲 インストール方法を見る</a>
        <a href={HOME_URL} class="foot-link">← Tanect Home のトップへもどる</a>
      </section>
    </div>
  </main>

  <footer class="page-foot">
    <p class="page-foot-copy">© 2026 Tanect</p>
  </footer>
</BaseLayout>

<style>
  /* ── ヘッダー（最小：ロゴのみ） ── */
  .page-head {
    border-bottom: 1px solid var(--color-border-subtle);
    background: rgba(255, 255, 255, 0.9);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-md);
    font-weight: 700;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: block;
  }

  .logo-text {
    font-size: 20px;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  /* ── 本文 ── */
  .notes {
    padding: var(--space-3xl) var(--space-md);
    background: linear-gradient(180deg, var(--color-accent-soft) 0%, #ffffff 280px);
  }

  .notes-inner {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .intro-title {
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--color-text);
    letter-spacing: 0.012em;
  }

  .intro-lead {
    font-size: var(--fs-body);
    line-height: 1.9;
    color: var(--color-text-muted);
  }

  .section-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-text);
  }

  /* ── 現在公開中のバージョン ── */
  .current {
    margin-bottom: var(--space-3xl);
  }

  .table-wrap {
    margin-top: var(--space-md);
    overflow-x: auto;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-card-bg);
  }

  .ver-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .ver-table th,
  .ver-table td {
    padding: var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
    white-space: nowrap;
  }

  .ver-table thead th {
    background: var(--color-bg-soft);
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .ver-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .os-emoji {
    margin-right: 6px;
