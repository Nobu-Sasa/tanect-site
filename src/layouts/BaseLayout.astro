---
import '../styles/global.css';
import { GA_MEASUREMENT_ID, INDEXABLE_PATHS } from '../config';

export interface Props {
  title?: string;
  description?: string;
  /** 通常は指定不要。既定は config.ts の INDEXABLE_PATHS から自動判定される（リスト外＝noindex）。 */
  noindex?: boolean;
}

const {
  title = 'Tanect Home — 日々のあゆみを、家族とつなぐ',
  description = '離れて暮らすご家族と、日々のあゆみをそっと共有するアプリ。言葉にしない気配まで、やさしくつなぐ。見守りではなく、つながりを。',
  noindex,
} = Astro.props;

// 検索可否は config.ts の INDEXABLE_PATHS が正本（未掲載のページは自動で noindex）。
// 末尾スラッシュの有無を吸収してから照合する（GitHub Pages は /about → /about/ に 301 する）。
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isNoindex = noindex ?? !INDEXABLE_PATHS.includes(path);

// astro.config.mjs で site を設定済みのため必ず存在する。
const canonicalUrl = new URL(path === '/' ? '/' : `${path}/`, Astro.site!).href;

// GA4 の初期化スニペット。Google 公式の書式（測定IDをリテラルで埋め込む）をそのまま出力する。
const gaSnippet = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${GA_MEASUREMENT_ID}');
`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* 検索公開範囲の正本は config.ts の INDEXABLE_PATHS。載せるページを増やすときはそこに追記する。
        robots.txt では意図的に何もブロックしていない（Disallow すると本文を読めず noindex を認識できないため）。 */}
    {isNoindex ? (
      <Fragment>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
      </Fragment>
    ) : (
      /* 検索に載せるページだけ canonical を出す（noindex と canonical の併用は矛盾した指示になるため）。 */
      <link rel="canonical" href={canonicalUrl} />
    )}
    <meta name="description" content={description} />
    {/* favicon はコーポレートマーク。SVG が第一候補（ダークモードで白線に反転）、PNG は Safari 等のフォールバック（白地に黒線）。 */}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon-192.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon-192.png`} />

    <!-- Fonts: Inter (latin) + Noto Sans JP (日本語) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Tanect（タネクト）" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* GA4: 測定IDが設定されているときだけ読み込む（config.ts の GA_MEASUREMENT_ID）。
        ⚠️ define:vars は使わない。IIFE で包まれ `gtag('config', 変数)` の形で出力されるため、
        Search Console の「Google アナリティクス」による所有権確認がトラッキングコードを
        検出できなかった（2026-07-29 実測）。Google 公式スニペットの形をそのまま出す。
        gtag は module ではない素の <script> の関数宣言＝グローバルになるので、
        body 末尾のCTAクリック計測が参照する window.gtag もこのまま動く。 */}
    {GA_MEASUREMENT_ID && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline set:html={gaSnippet}></script>
      </Fragment>
    )}
  </head>
  <body>
    <slot />

    {/* CTAクリック計測：data-track-event を持つ要素のクリックを GA4 イベントとして送る。
        gtag 未定義（GA_MEASUREMENT_ID 未設定）のときは何もしない。 */}
    <script>
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest<HTMLElement>('[data-track-event]');
        if (!el) return;
        const eventName = el.dataset.trackEvent;
        const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
        if (!eventName || typeof gtag !== 'function') return;
        gtag('event', eventName, {
          cta_location: el.dataset.ctaLocation || undefined,
        });
      });
    </script>
  </body>
</html>
